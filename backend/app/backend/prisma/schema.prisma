generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//conceitos(pilares de ds) pais
model Concept {
  // Front: id: "math"
  id              String  @id 
  
  //front é title, ex "Matemática"
  title           String  
  
  //front é description (do card inicial)
  description     String  
  
  // descrição da pagina de livros, texto
  fullDescription String? @db.Text 
  
  // icon
  iconName        String  
  
  //cores
  color           String  
  bgGradient      String  
  
  books           Book[]
}

//livros (filhos)
model Book {
  //slugs
  id            String   @id 

  order         Int
  
  title         String
  author        String?  //opcional pq as categorias de projetos não tem autor
  
  //emoji 
  emoji         String?  
  
  //coverImage é opcional
  coverImage    String?  
  
  conceptId     String
  concept       Concept  @relation(fields: [conceptId], references: [id])
  
  chapters      Chapter[]
}

//capitulos (netos)
model Chapter {
  id        String   @id @default(uuid())
  
  titlePt   String
  titleEn   String?
  
  // Front: youtubeId (LCCiwPEdEpg)
  youtubeId String?  
  
  //string p compatibilidade c o front
  duration  String?  
  
  order     Int      @default(0)
  
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id])
  
  usersCompleted UserProgress[]
}

//usuario e progresso
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String   // NOVO
  password  String   // NOVO: Será o hash, não o texto puro
  createdAt DateTime @default(now())
  progress  UserProgress[]
}

model UserProgress {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  chapterId   String
  chapter     Chapter  @relation(fields: [chapterId], references: [id])
  completedAt DateTime @default(now())

  @@unique([userId, chapterId])
}